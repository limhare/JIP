<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:InstPlayerApp.Converters"
             x:Class="InstPlayerApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:BoolToActiveColorConverter x:Key="BoolToActiveColor" />
            <conv:DivideBy100Converter x:Key="DivideBy100" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
